# Large local model weights. Keep the folder structure, but never commit AI weights.
/ComfyUI/models/

# Portable local runtime: Python, PyTorch, CUDA DLLs, and installed packages.
/python_embeded/

# Downloaded installers and archives used only to bootstrap this local installation.
/downloads/

# Generated logs from local launches and tests.
/logs/

# Local bytecode generated by the portable Python test helpers.
/tools/__pycache__/

# Atlas Cloud is an isolated runtime. Its API key, inputs, outputs, local state,
# and vendor node checkout must stay on this computer.
/AtlasCloud/custom_nodes/atlascloud_comfyui/
/AtlasCloud/input/
/AtlasCloud/output/
/AtlasCloud/temp/
/AtlasCloud/user/
/AtlasCloud/models/
/AtlasCloud/logs/
/AtlasCloud/secrets/
/AtlasCloud/history/
